
<h2>Create Order:</h2>

<form asp-controller="Order" asp-action="Create" method="post">
    <div>
        <label name="Name">Name:</label>
        <input name="Name" />
    </div>
    <div>
        <label name="Price">Price:</label>
        <input name="Price" />
    </div>
    <div>
        <label name="Quantity">Quantity:</label>
        <input name="Quantity" />
    </div>
    <div>
        <label name="CustomName">Custom Name:</label>
        <input name="CustomName" />
    </div>
    <div>
        <label name="Status">Status:</label>
        <input name="Status" />
    </div>
    <button type="submit">Create</button>
</form>

